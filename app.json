{
  "expo": {
    "name": "Expiry Radar",
    "slug": "expiry-radar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expiryradar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.expiryradar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Expiry Radar uses the camera to scan grocery barcodes and receipts.",
        "NSPhotoLibraryUsageDescription": "Expiry Radar lets you attach a photo of an item or receipt."
      }
    },
    "android": {
      "package": "com.expiryradar.app",
      "adaptiveIcon": {
        "backgroundColor": "#2D9D6F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF9F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#171D1A" }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Expiry Radar uses the camera to scan grocery barcodes and receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Expiry Radar lets you attach a photo of an item or receipt." }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
